# =============================================
# VoteSync Environment Variables
# Salin file ini ke .env dan sesuaikan nilainya
# =============================================

# ----- Keamanan -----

# JWT Secret Key - untuk enkripsi sesi login admin & pemilih
# Gunakan string random yang kuat (min. 32 karakter)
JWT_SECRET_KEY="ganti-dengan-string-acak-panjang-untuk-production"

# Vote Secret Salt - untuk anonymisasi suara pemilih via SHA-256
# JANGAN diubah setelah pemilihan berjalan, atau data suara tidak akan terbaca!
VOTE_SECRET_SALT="ganti-dengan-string-acak-lain-yang-berbeda-dari-jwt"
INITIAL_ADMIN_PASSWORD="ganti-dengan-password-awal-super-admin-yang-kuat"

# ----- Cookie -----

# Cookie Security Setting
# - Production/HTTPS: set ke "true"
# - HTTP lokal tanpa SSL: set ke "false"
# Jika tidak diset di aplikasi production, cookie akan menggunakan Secure.
COOKIE_SECURE="false"

# ----- Database PostgreSQL -----
# Digunakan oleh service postgres di Docker Compose

POSTGRES_USER="votesync"
POSTGRES_PASSWORD="ganti-dengan-password-kuat"
POSTGRES_DB="votesync"

# ----- Aplikasi -----

# Port yang diexpose ke host oleh Docker Compose
APP_PORT="3000"
